# Copy this file to `.env` and fill in the values from the Discord Developer Portal.
# `.env` is gitignored — never commit real secrets.

# Application ID (public) — General Information page.
DISCORD_CLIENT_ID=1544440867799048253

# Client Secret — OAuth2 page. Click "Reset Secret", then paste it here.
# Used ONLY by the server for the OAuth token exchange; never sent to clients.
DISCORD_CLIENT_SECRET=

# Address the server listens on (default :8080).
JANJACAST_ADDR=:8080

# Optional: base64-encoded 32+ byte key signing companion share tokens.
# Without it a random per-process key is used and tokens die on restart.
# Generate: openssl rand -base64 32
JANJACAST_TOKEN_SECRET=

# Optional: log level (debug|info|warn|error), default info.
JANJACAST_LOG_LEVEL=info

# Total relay egress budget in kbit/s (stream bitrate x viewers ceiling).
# Default 25000 (~25 Mbps, safe for most residential uplinks). Set 0 for
# unlimited on a VPS with real bandwidth.
JANJACAST_EGRESS_BUDGET_KBPS=25000

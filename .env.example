# Copy this file to `.env` and fill in the values from the Discord Developer Portal.
# `.env` is gitignored — never commit real secrets.

# Application ID (public) — General Information page.
DISCORD_CLIENT_ID=1544440867799048253

# Client Secret — OAuth2 page. Click "Reset Secret", then paste it here.
# Used ONLY by the server for the OAuth token exchange; never sent to clients.
DISCORD_CLIENT_SECRET=

# Address the server listens on (default :8080).
JANJACAST_ADDR=:8080
